# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# test artifacts
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/tests/e2e/.auth/

# bug-hunt raw results (may contain relayer responses; summarized in FINDINGS.md)
/bug-hunt/results/

# local tooling
.claude/settings.local.json

# evidence text exports (real memory text; never commit without written consent)
/docs/evidence/export-*/text-*.json

# Private working material — never pushed
/bug-hunt/
/docs/article/
/docs/SUBMISSION_CHECKLIST.md
/docs/SUBMISSION_FORM.md
/eval/
