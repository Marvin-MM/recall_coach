# Copy to .env.local and fill in. Everything here is validated by src/env.ts;
# `pnpm build` fails with a readable list if a required value is missing/invalid.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com            # comma-separated; gates /admin/evidence

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=                     # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=                       # Google Cloud Console → Credentials → OAuth client (Web)
GOOGLE_CLIENT_SECRET=                   # redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google

# --- Database ---
# Local dev: postgres://postgres:postgres@localhost:5432/recall_coach
# Neon: pooled string for DATABASE_URL, direct (unpooled) string for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# DATABASE_DRIVER=                      # optional: neon | pg (default: neon for *.neon.tech hosts, else pg)

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b             # must not be an OpenAI or Anthropic model
GROQ_EXTRACTION_MODEL=qwen/qwen3.8-27b

# --- Walrus Memory (server only, Mainnet) ---
MEMWAL_PRIVATE_KEY=                     # DELEGATE key hex (64 chars) from the Walrus Memory dashboard. Never the owner key.
MEMWAL_ACCOUNT_ID=                      # 0x… MemWalAccount object id
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE_PREFIX=coach-v1        # use coach-preview-v1 for Vercel Preview
# Measured on Mainnet (2026-09-22): warm recall ≈1.4 s, cold ≈4.7 s, 3 parallel up to ≈7 s;
# rememberAndWait ≈35 s. The spec's 3000/20000 defaults degrade most turns — see docs/SDK_NOTES.md.
MEMWAL_RECALL_TIMEOUT_MS=6000
MEMWAL_SAVE_TIMEOUT_MS=45000
# ALLOW_CUSTOM_RELAYER=false            # production only allows the mainnet relayer unless true

# --- Rate limiting (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Explorer links (public; must end with /) ---
NEXT_PUBLIC_WALRUS_EXPLORER_BLOB_URL=https://walruscan.com/mainnet/blob/
NEXT_PUBLIC_SUI_EXPLORER_OBJECT_URL=https://suiscan.xyz/mainnet/object/

# --- Cron ---
CRON_SECRET=                            # openssl rand -hex 24; Vercel sends it as Bearer token to /api/cron/health

# --- Test only (rejected when NODE_ENV=production) ---
# MEMORY_DRIVER=fake
# LLM_DRIVER=fake
# E2E_AUTH_SECRET=

# --- Encrypted transcripts (session history for the user; never read across sessions by the coach) ---
TRANSCRIPT_ENCRYPTION_KEY=              # openssl rand -base64 32 (32 bytes). Keep secret; losing it makes stored transcripts unreadable
TRANSCRIPT_KEY_VERSION=1                # bump when rotating; new messages use the current key
TRANSCRIPT_PREVIOUS_KEYS=               # optional, retired keys still needed for reading: "1:<base64>,2:<base64>"

