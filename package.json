{
  "name": "recall-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "pnpm dlx auth@1.7.5 generate --config scripts/auth-cli.config.ts --adapter drizzle --dialect postgresql --output src/server/db/auth-schema.ts -y && biome check --write src/server/db/auth-schema.ts",
    "memwal:verify": "tsx --conditions=react-server scripts/memwal-verify.ts",
    "memwal:stats": "tsx --conditions=react-server scripts/memwal-stats.ts",
    "evidence:export": "tsx --conditions=react-server scripts/evidence-export.ts",
    "probes": "tsx --conditions=react-server bug-hunt/run-probes.ts",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.66",
    "@ai-sdk/react": "^3.0.289",
    "@mysten-incubation/memwal": "0.1.8",
    "@mysten/seal": "^1.4.13",
    "@mysten/sui": "^2.31.3",
    "@mysten/walrus": "^1.2.28",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.9.8",
    "ai": "^6.0.286",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.2",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.14",
    "@electric-sql/pglite": "^0.5.8",
    "@next/env": "16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  }
}
